# Copy these values into Windows environment variables before starting Flask.
# Never commit a real email password or Google secret to the project.
MSME_SECRET_KEY=replace-with-a-long-random-value
MSME_PORT=5050

# Email OTP delivery (example values for Gmail SMTP)
MSME_SMTP_HOST=smtp.gmail.com
MSME_SMTP_PORT=587
MSME_SMTP_TLS=true
MSME_SMTP_USER=your-email@gmail.com
MSME_SMTP_PASSWORD=your-email-app-password
MSME_SMTP_FROM=your-email@gmail.com

# Google Identity Services web client ID (not the client secret)
MSME_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Private Cloudflare R2 photo storage. Leave all four values blank locally to
# retain the SQLite/Neon Base64 fallback. Never commit real R2 credentials.
MSME_R2_ACCOUNT_ID=your-cloudflare-account-id
MSME_R2_ACCESS_KEY_ID=your-r2-access-key-id
MSME_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
MSME_R2_BUCKET_NAME=msme-private-photos
MSME_R2_PRESIGNED_TTL_SECONDS=900
